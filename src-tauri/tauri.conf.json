{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mudae crop",
  "version": "0.2.0",
  "identifier": "com.phsebastiao.mudaecrop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run waifu2x:install",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "config": "$LOCALDATA/Mudae Crop"
    },
    "windows": [
      {
        "title": "mudae crop",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["waifu2x"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/PHSebastiao/mudae-crop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQ0M5RkE4NTU5M0VEN0UKUldSKzdaTlZxSi9Nb1laWGxNNmNRaTZNbStadnlieFl4dmcweXlXRG1nQUhqdmVsTkN5TWVUVFMK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
